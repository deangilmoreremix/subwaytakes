# Supabase (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Remotion web renderer license key (https://remotion.dev/license).
# Defaults to "free-license", valid for individuals and companies up to 3 people.
VITE_REMOTION_LICENSE_KEY=

# How customers pay. Unset or 'byok' (default): each customer pastes their own muapi key and pays muapi directly.
# 'credits': the earlier model (server-held key, credits ledger, Stripe). Needs the credits/checkout backend.
VITE_BILLING_MODE=

# The muapi key is NOT set here. Each user pastes their own in the key dialog (or Settings); it stays in the browser.
