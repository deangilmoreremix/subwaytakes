# SubwayTakes — Environment Configuration
# Copy to .env and fill in. VITE_* vars are bundled into the frontend by Vite;
# everything else is only read by Supabase Edge Functions / the render worker.

# --- Supabase (required) ---
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge functions + render worker (server-side only, never exposed to the client)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Video generation ---
# MuAPI (Subway Interview Studio scene generation + AI captions)
MUAPI_API_KEY=your-muapi-api-key
# Optional overrides (defaults shown)
MUAPI_BASE_URL=https://api.muapi.ai/api/v1

# OpenAI (interview script planning, plan-interview edge function)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Legacy providers (optional — generate-video falls back to an error, never a demo clip)
MINIMAX_API_KEY=
GOOGLE_AI_API_KEY=

# --- FFmpeg / thumbnail service (optional, legacy pipeline) ---
THUMBNAIL_SERVICE_URL=http://localhost:3001
THUMBNAIL_SERVICE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Render worker (render-worker/) ---
WORKER_API_KEY=choose-a-strong-random-key
WORKER_PORT=3010
REPO_ROOT=..                # repo root (contains remotion/ and node_modules)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
REMOTION_CONCURRENCY=2
RENDER_TIMEOUT_MS=600000
JOB_TIMEOUT_MS=900000
MAX_CONCURRENCY=1

# --- Edge functions CORS (comma-separated origins; unset = * for local dev) ---
ALLOWED_ORIGINS=
