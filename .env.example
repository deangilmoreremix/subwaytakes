# Supabase (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Remotion web renderer license key (https://remotion.dev/license).
# Defaults to "free-license", valid for individuals and companies up to 3 people.
VITE_REMOTION_LICENSE_KEY=

# The muapi key is NOT set here. Each user pastes their own in Settings; it stays in the browser.
