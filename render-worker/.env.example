# Render worker environment — copy to .env and fill in.
# Every variable the worker reads is documented here.

# ---- server ----
# Port the Express API listens on.
PORT=3010

# ---- auth ----
# Bearer key for GET /status and POST /render. When EMPTY the service runs
# OPEN (same convention as thumbnail-service with no API_KEY) — only
# acceptable behind a private network. GET /health is always open.
WORKER_API_KEY=

# ---- supabase (service role bypasses RLS; the worker owns the queue) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- repo / binaries ----
# Repo root containing node_modules/.bin/remotion + remotion/src/index.ts.
REPO_ROOT=/repo
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ---- queue ----
# Poll interval for new queued jobs (ms).
POLL_INTERVAL_MS=3000
# How many renders may run at once on this worker.
MAX_CONCURRENCY=1
# A 'running' job with no heartbeat for this long (ms) is reset to 'queued'.
JOB_TIMEOUT_MS=900000
# Heartbeat cadence while rendering (ms) — must be well under JOB_TIMEOUT_MS.
HEARTBEAT_INTERVAL_MS=30000

# ---- remotion ----
# Remotion --timeout flag, in MILLISECONDS.
RENDER_TIMEOUT_MS=600000
# Remotion render concurrency (Chromium tabs in parallel).
REMOTION_CONCURRENCY=2
# Bundler entry registering the "SubwayEditor" composition (relative to
# REPO_ROOT). Defaults to the worker bridge entry because the repo's
# remotion/src/Root.tsx has a broken composition import (see
# render-worker/src/remotion-entry.tsx). Set to remotion/src/index.ts once
# Root.tsx is fixed.
REMOTION_ENTRY=render-worker/src/remotion-entry.tsx

# ---- delivery spec (encode gate) ----
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
OUTPUT_CRF=20
# Private bucket the final MP4 is uploaded to (path
# <user_id>/<project_id>/render-<job_id>.mp4).
STORAGE_BUCKET=studio-exports
# Signed URL lifetime in seconds (7 days).
SIGNED_URL_EXPIRY_SECONDS=604800
